[Unit]
Description=Askio Monitor Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=askio-agent
ExecStart=/usr/local/bin/askio-monitor start --config /etc/askio/monitor.conf
Restart=always
RestartSec=3

# Hardening (safe defaults; adjust if needed)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
